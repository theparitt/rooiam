{
  "name": "rooiam-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:docs": "node scripts/check-docs.mjs",
    "deploy": "npm run check:docs && VITE_BOOK_URL=https://book.rooiam.com npm run build && wrangler pages deploy dist --project-name rooiam-docs --branch main --commit-dirty=true"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wrangler": "4.78.0"
  }
}
