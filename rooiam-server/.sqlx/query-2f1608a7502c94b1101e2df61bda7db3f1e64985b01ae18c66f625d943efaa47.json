{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.id,\n                u.display_name,\n                u.avatar_url,\n                e.email as \"email?\",\n                e.is_verified as \"email_verified?\"\n            FROM users u\n            LEFT JOIN user_emails e\n                ON e.user_id = u.id\n               AND e.is_primary = true\n            WHERE u.id = $1\n            ",
