{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT o.id, o.slug, o.name, c.app_name, c.client_id\n        FROM organizations o\n        JOIN oauth_clients c ON c.org_id = o.id\n        WHERE o.slug = ANY($1)\n          AND c.app_type = 'spa'\n          AND c.org_id IS NOT NULL\n          AND c.app_name != 'Rooiam Admin Console'\n        ORDER BY o.name ASC\n        ",
